{
  "name": "leakguard",
  "version": "0.12.0",
  "description": "Secret-exposure seatbelt for AI coding agents. One detection engine (betterleaks), two hosts: pi.dev and OpenCode.",
  "main": "./index.ts",
  "type": "module",
  "scripts": {
    "test": "tsx --test security.test.ts context.test.ts llm-hints.test.ts coverage.test.ts shape.test.ts engine.test.ts",
    "typecheck": "tsc --noEmit",
    "ensure-engine": "sh scripts/ensure-engine.sh"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "opencode",
    "security",
    "secrets",
    "dlp",
    "betterleaks"
  ],
  "author": "calionauta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calionauta/leakguard.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "security.ts",
    "engine.ts",
    "context.ts",
    "llm-hints.ts",
    "shape.ts",
    "core",
    "packages",
    "hooks",
    "scripts",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ]
}
